# Copie para .env e ajuste. O .env não vai para o Git.

# PostgreSQL. Duas opções:
#  a) Docker:  docker compose up -d   (porta 5433, utilizador/senha do docker-compose.yml)
#  b) PostgreSQL instalado no Windows (porta 5432): criar um utilizador e a base, ex.:
#       CREATE ROLE agrodiagnostico LOGIN PASSWORD '...';
#       CREATE DATABASE agrodiagnostico OWNER agrodiagnostico;
#     DATABASE_URL=postgresql+asyncpg://agrodiagnostico:SENHA@localhost:5432/agrodiagnostico
# Só para experiências rápidas, sem PostgreSQL:
#   DATABASE_URL=sqlite+aiosqlite:///./dados/agrodiagnostico.db
DATABASE_URL=postgresql+asyncpg://agrodiagnostico:agrodiagnostico@localhost:5433/agrodiagnostico

# Chave para assinar os tokens JWT. Gere uma nova, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=mude-esta-chave
JWT_VALIDADE_DIAS=30

# Administrador criado no arranque, se ainda não existir.
ADMIN_TELEFONE=840000000
ADMIN_PALAVRA_PASSE=mude-esta-palavra-passe
ADMIN_NOME=Administrador
