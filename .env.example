# ==============================================================
# Configuração para Deploy na VPS (docker compose)
# Copie este ficheiro para .env antes de executar:
#   cp .env.example .env
# ==============================================================

# 1. Base de dados PostgreSQL
POSTGRES_PASSWORD=agrodiagnostico_senha_segura

# 2. Segurança da API (JWT)
JWT_SEGREDO=coloque_aqui_uma_chave_longa_e_aleatoria_para_o_jwt

# 3. Credenciais da conta Administrador inicial
ADMIN_TELEFONE=840000000
ADMIN_PALAVRA_PASSE=jK54z0kDQMTI

# 4. Portas expostas na VPS
PORTA_API=8000
PORTA_ADMIN=80

# 5. URL da API para o Painel Web (Navegador)
# Substitua pelo IP da sua VPS ou pelo seu domínio:
# Exemplo com IP: http://123.45.67.89:8000
# Exemplo com domínio: https://api.seu-dominio.com
VITE_API_URL=http://localhost:8000

# 6. Origens autorizadas pela API (CORS)
# ["*"] autoriza qualquer origem (app mobile + painel web)
CORS_ORIGENS=["*"]

# 7. SMS (API Ola da Pavulla)
SMS_CHAVE=sua_chave_ola_pavulla_aqui
SMS_REMETENTE=99988
SMS_PROVIDER_ID=pro-2ziqAEvdDobNcPnsN6tFwPHOa2g
